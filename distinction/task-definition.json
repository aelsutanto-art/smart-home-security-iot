{
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/LabRole",
  "networkMode": "awsvpc",
  "cpu": "256",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/LabRole",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "containerDefinitions": [
    {
      "environment": [
        {
          "value": "us-east-1",
          "name": "AWS_REGION"
        },
        {
          "value": "https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/smart-home-security-events",
          "name": "EVENTS_QUEUE_URL"
        },
        {
          "value": "https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/smart-home-security-results",
          "name": "RESULTS_QUEUE_URL"
        },
        {
          "value": "200",
          "name": "PROCESSING_DELAY_MS"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-group": "/ecs/smart-home-processor"
        }
      },
      "name": "processor",
      "essential": true,
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/smart-home-processor:latest"
    }
  ],
  "family": "smart-home-processor"
}
